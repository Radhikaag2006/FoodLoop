ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DB_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Optional email for password reset codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FoodLoop <no-reply@yourdomain.com>
# Payments: Razorpay TEST keys only (Dashboard > Test mode > API keys).
# Leave both empty to use the built-in simulated gateway (development only).
# rzp_live_ keys are refused unless ALLOW_LIVE_PAYMENTS=1.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# UPI QR for ride bills. Money is paid straight to this UPI ID, so it must be
# YOUR account. Leave it empty to get a harmless demo QR (development only).
UPI_VPA=
UPI_PAYEE_NAME=FoodLoop
# Pickups every new business gets free
FREE_PICKUPS=3
# AI / Regulatory Copilot: optional Google Gemini API key.
# Leave empty to use the built-in offline RAG retrieval engine.
GEMINI_API_KEY=
# Never set DEMO_MODE=1 in production
DEMO_MODE=0

# One-time: make an EXISTING admin use ADMIN_EMAIL / ADMIN_PASSWORD (forgotten
# password). Set to 1 for one deploy, then remove it.
ADMIN_PASSWORD_RESET=0
